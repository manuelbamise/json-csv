{
  "name": "json-to-csv",
  "version": "1.0.0",
  "description": "Extract profile data from a JSON file and export it as a CSV file",
  "keywords": [
    "json-to-csv",
    "data-extraction",
    "csv-export",
    "typescript",
    "nodejs"
  ],
  "license": "MIT",
  "author": "Bamise <bamise.dev@gmail.com>",
  "type": "module",
