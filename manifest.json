{
  "name": "Slack scraper",
  "description": "A chrome extension for scraping slack channel",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "public/index.html",
    "default_icon": "public/slack.png"
  },
  "permissions": ["activeTab", "downloads", "scripting", "nativeMessaging"],
  "host_permissions": ["https://app.slack.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["src/content.js"]
    }
  ]
}
